# DentiFlow Environment Configuration
# For production on Render, ensure all required variables are set via Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
# SECRET_KEY is REQUIRED - generate a strong random value for production
# Render.com will auto-generate this via render.yaml
SECRET_KEY=your-production-secret-key-change-me
# For Render deployment, use: /data/dentiflow.db
DATABASE_URL=/data/dentiflow.db
CLINIC_NAME=DentiFlow Dental Care & Implant Center
CLINIC_CURRENCY=$
CLINIC_TAX_RATE=5.0
